### Frontend cloud RAG endpoint
# Cloudflare Worker URL or Hugging Face Space URL.
# Examples:
# NEXT_PUBLIC_CLOUD_RAG_ENDPOINT=https://pbx-rag-engine.<account>.workers.dev/
# NEXT_PUBLIC_CLOUD_RAG_ENDPOINT=https://<user>-pbx-rag-engine.hf.space/
NEXT_PUBLIC_CLOUD_RAG_ENDPOINT=
CLOUD_RAG_ENDPOINT=

### RAG asset prefix
RAG_ASSET_PREFIX=latest

### Cloudflare Worker/R2 deployment
# Used by .github/workflows/report.yml to upload reports/data into R2.
# If you use an Account API Token such as pbx_application_token, set only
# CLOUDFLARE_API_TOKEN, CLOUDFLARE_ACCOUNT_ID, and CLOUDFLARE_R2_BUCKET. Leave
# the S3 access key fields empty so CI uses Wrangler remote upload.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_R2_BUCKET=auto-rag
# Optional S3 API upload path for Cloudflare R2. If these are set, CI uses the
# S3 API instead of Wrangler for asset uploads.
CLOUDFLARE_R2_S3_ENDPOINT=https://ppp
CLOUDFLARE_R2_S3_ACCESS_KEY_ID=
CLOUDFLARE_R2_S3_SECRET_ACCESS_KEY=

### Hugging Face Docker Space deployment
# CPU Basic Spaces can host the self-developed Docker RAG engine for free.
# HF_SPACE_ID format: <username-or-org>/<space-name>
HF_TOKEN=
HF_SPACE_ID=

### NotebookLM optional unofficial upload bridge
# Google NotebookLM has no official public file-upload API. Leave these empty
# unless you run notebooklm-rest-api/notebooklm-py or a compatible bridge.
NOTEBOOKLM_UPLOAD_URL=
NOTEBOOKLM_API_TOKEN=
NOTEBOOKLM_TIMEOUT=60

### RAG engine runtime
PORT=7860
HOST=0.0.0.0
ALLOWED_ORIGINS=*
HF_RAG_ASSET_ROOT=/app/dist/hf_assets
USE_WORKERS_AI=false
