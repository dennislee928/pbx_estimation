{
 "cells": [
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# 04 — Survival Analysis (Cox Proportional Hazards)\n",
    "\n",
    "Estimates product survival probability given market conditions.\n",
    "Model: $h(t|X) = h_0(t) \\exp(\\sum \\beta_i X_i)$"
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "source": [
    "import sys\n",
    "from pathlib import Path\n",
    "sys.path.insert(0, str(Path.cwd()))\n",
    "\n",
    "import pandas as pd\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "import warnings\n",
    "warnings.filterwarnings('ignore')\n",
    "\n",
    "from src.models.survival import (\n",
    "    fit_cox_model, plot_survival_curves, \n",
    "    predict_survival_probability, rank_markets,\n",
    "    plot_hazard_ratios\n",
    ")\n",
    "from src.data.preprocessor import build_product_lifetime_table"
   ],
   "outputs": [],
   "execution_count": null
  },
  {
   "cell_type": "code",
   "metadata": {},
   "source": [
    "panel = pd.read_csv('data/processed/panel_data.csv')\n",
    "print(f\"Panel loaded: {panel.shape}\")\n",
    "print(f\"Columns: {panel.columns.tolist()}\")"
   ],
   "outputs": [],
   "execution_count": null
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 4.1 Build Product Lifetime Table\n",
    "\n",
    "Product: \"Traditional PBX Gateway\" — introduced in 2005."
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "source": [
    "product_intro_year = 2005\n",
    "lifetime = build_product_lifetime_table(\n",
    "    panel,\n",
    "    product_intro_year=product_intro_year,\n",
    "    penetration_col='fixed_subs_value',\n",
    "    death_threshold=0.05,\n",
    ")\n",
    "print(f\"Lifetime table: {lifetime.shape[0]} countries\")\n",
    "lifetime"
   ],
   "outputs": [],
   "execution_count": null
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 4.2 Fit Cox Proportional Hazards Model"
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "source": [
    "covariates = ['broadband_value', 'gdp_per_capita_value', \n",
    "              'urban_pop_value', 'has_pstn_phaseout']\n",
    "available_covs = [c for c in covariates if c in lifetime.columns]\n",
    "print(f\"Using covariates: {available_covs}\")\n",
    "\n",
    "model = fit_cox_model(\n",
    "    lifetime,\n",
    "    duration_col='market_lifetime',\n",
    "    event_col='product_dead',\n",
    "    covariates=available_covs,\n",
    "    penalizer=0.1,\n",
    ")\n",
    "print(\"CoxPH model fitted successfully.\")\n",
    "model.print_summary()"
   ],
   "outputs": [],
   "execution_count": null
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 4.3 Hazard Ratios"
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "source": [
    "fig, ax = plt.subplots(figsize=(8, 5))\n",
    "plot_hazard_ratios(model, ax=ax)\n",
    "plt.tight_layout()\n",
    "plt.savefig('data/processed/hazard_ratios.png', dpi=150, bbox_inches='tight')\n",
    "plt.show()\n",
    "print(\"\\nInterpretation:\")\n",
    "print(\"  HR > 1 = higher risk (product dies sooner)\")\n",
    "print(\"  HR < 1 = lower risk (product survives longer)\")"
   ],
   "outputs": [],
   "execution_count": null
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 4.4 Survival Curves by Country"
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "source": [
    "countries = lifetime['country'].tolist()\n",
    "fig, ax = plt.subplots(figsize=(10, 6))\n",
    "plot_survival_curves(model, countries, lifetime, t_max=20, ax=ax)\n",
    "plt.tight_layout()\n",
    "plt.savefig('data/processed/survival_curves.png', dpi=150, bbox_inches='tight')\n",
    "plt.show()"
   ],
   "outputs": [],
   "execution_count": null
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 4.5 Market Rankings"
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "source": [
    "for t in [3, 5, 10]:\n",
    "    rankings = rank_markets(model, lifetime, t=t)\n",
    "    print(f\"\\n=== Market Rankings: {t}-year Survival Probability ===\")\n",
    "    print(rankings.to_string(index=False))"
   ],
   "outputs": [],
   "execution_count": null
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 4.6 Scenario: Product Launch Decision"
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "source": [
# 4.6 Scenario: Product Launch Decision
scenarios = [
    {"name": "Taiwan (no PSTN phaseout)", "covs": {
        'broadband_value': 35.0, 'gdp_per_capita_value': 35000,
        'urban_pop_value': 80.0, 'has_pstn_phaseout': 0}},
    {"name": "Germany (with phaseout)", "covs": {
        'broadband_value': 42.0, 'gdp_per_capita_value': 48000,
        'urban_pop_value': 77.0, 'has_pstn_phaseout': 1}},
    {"name": "India (growing market)", "covs": {
        'broadband_value': 8.0, 'gdp_per_capita_value': 2500,
        'urban_pop_value': 35.0, 'has_pstn_phaseout': 0}},
    {"name": "Japan (historical baseline)", "covs": {
        'broadband_value': 14.4, 'gdp_per_capita_value': 31509,
        'urban_pop_value': 65.9, 'has_pstn_phaseout': 0}},
    {"name": "South Korea (historical baseline)", "covs": {
        'broadband_value': 11.4, 'gdp_per_capita_value': 31770,
        'urban_pop_value': 66.7, 'has_pstn_phaseout': 0}},
]

print("=== Scenario: Product Launch Decision ===")
for sc in scenarios:
    # 確保只取用模型建立時存在的變數
    available_covs_filtered = [c for c in available_covs if c in sc['covs']]
    filtered_covs = {k: v for k, v in sc['covs'].items() if k in available_covs_filtered}
    
    # 預測存活率
    s3 = predict_survival_probability(model, filtered_covs, t=3)
    s5 = predict_survival_probability(model, filtered_covs, t=5)
    s10 = predict_survival_probability(model, filtered_covs, t=10)
    
    # 輸出結果
    print(f"\n{sc['name']}")
    print(f"  3-year survival: {s3:.1%}")
    print(f"  5-year survival: {s5:.1%}")
    print(f"  10-year survival: {s10:.1%}")
   "outputs": [],
   "execution_count": null
  }
 ],
